OPENAI_API_KEY=

# Pinecone (vector store for RAG)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=
# Optional: use host URL from Pinecone console instead of index name (serverless indexes)
# PINECONE_HOST=

# Embeddings — keep the same model at ingest and query time
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# Chunking for POST /ingest
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100

# Retrieval for POST /ask and GET /debug/retrieve
RAG_RETRIEVAL_TOP_K=5
